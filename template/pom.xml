<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.study</groupId>
        <artifactId>sdet-study</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>template</artifactId>
    <name>template</name>
    <description>Stage 4 working template: the stage 2 layers assembled by a Spring Boot test context, the environment
        either a running stand or started by Testcontainers</description>

    <dependencyManagement>
        <dependencies>
            <!-- Imported here and not in the parent: a BOM also re-versions transitive dependencies, and the other
                 modules must not change because this one uses Spring. Versions declared in the parent
                 (JUnit, AssertJ, Jackson, RestAssured, Postgres) still win over the imported ones. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The layers of stage 2, unchanged: none of them knows about Spring -->
        <dependency>
            <groupId>com.study</groupId>
            <artifactId>framework-domain</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <!-- From RestAssured's httpclient; Spring's spring-jcl provides the same API and warns about a second copy -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- The wiring, the test kinds and the environments are main code of this module (as in framework/tests) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- Stage 4b: EventClient (events/) and the broker of the containers environment -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
        </dependency>
        <!-- Stage 4c: the report. The listener observes the JUnit Platform (auto-registered by ServiceLoader);
             steps come from report/ (decorators + an aspect woven at load time), never from framework/ -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-java-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjrt</artifactId>
        </dependency>
        <!-- Not on the class path at run time for its classes: Surefire starts it as -javaagent (see below) -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Build order only: the containers environment builds the SUT image from sut/target/sut.jar, so -am must
             package sut first. type=pom + exclusions: nothing of the SUT lands on this module's class path -->
        <dependency>
            <groupId>com.study</groupId>
            <artifactId>sut</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Layer rules of the assembly as tests: ArchitectureTest -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- One JVM for the whole module: a fork is another Spring context, another environment
                         (containers) and another browser pool. Parallelism is inside it (junit-platform.properties) -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- The weaver of report/ReportingAspect; without it the run is the same, only without steps.
                         add-opens: the weaver defines generated classes through ClassLoader (JDK 16+) -->
                    <argLine>
                        -javaagent:${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar
                        --add-opens java.base/java.lang=ALL-UNNAMED
                    </argLine>
                    <!-- Local runs never retry: a flaky test fails where its author sees it (profile ci below) -->
                    <rerunFailingTestsCount>${template.rerun}</rerunFailingTestsCount>
                </configuration>
            </plugin>
            <!-- mvn -pl template allure:serve (after a run) | allure:report -> target/site/allure-maven-plugin -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <configuration>
                    <reportVersion>${allure-report.version}</reportVersion>
                    <resultsDirectory>allure-results</resultsDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <template.rerun>0</template.rerun>
    </properties>

    <profiles>
        <!-- CI (active when the CI variable is set, as on GitHub Actions; or -Pci): a failed test gets one more
             attempt. Passed on the second = "flaky" in the Surefire XML and in Allure's Retries: green, but visible.
             The Spring profile ci (fail on a missing environment) is separate: -Dspring.profiles.active=ci -->
        <profile>
            <id>ci</id>
            <activation>
                <property>
                    <name>env.CI</name>
                </property>
            </activation>
            <properties>
                <template.rerun>1</template.rerun>
            </properties>
        </profile>
    </profiles>
</project>
